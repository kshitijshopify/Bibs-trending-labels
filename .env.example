# Copy to .env for local development. `shopify app dev` provides
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL / SCOPES itself.
# Everything below defaults to OFF.

# SQLite file, relative to prisma/schema.prisma (= prisma/dev.sqlite).
DATABASE_URL="file:dev.sqlite"

# Default tag (the Settings page in the app overrides it per shop). The detailed
# brief says label:BESTSELLER (existing tag), the summary brief says label:Trending.
BESTSELLER_LABEL_TAG=label:Trending

# --- Development store only ------------------------------------------------
# The dev store is probably not on Europe/Copenhagen; allow it with a warning.
BESTSELLER_ALLOW_TIMEZONE_MISMATCH=true
# Include today's orders in the window (non-standard; dev testing only).
BESTSELLER_DEV_WINDOW_INCLUDE_TODAY=false

# --- Flow handoff ------------------------------------------------------------
# When true, "Run and send Flow trigger events" and nightly runs send the
# trigger events. Emails only go out if a workflow with an email action is ON.
BESTSELLER_FLOW_TRIGGER_ENABLED=false

# --- Product updates (keep false until the merchant approves previews) ------
BESTSELLER_APPLY_ENABLED=false
BESTSELLER_APPLY_ALLOWED_SHOPS=
# Approval mode (manual / automatic nightly) is chosen on the Settings page.
# Secret for signing email approval links (optional; falls back to SHOPIFY_API_SECRET).
BESTSELLER_APPROVAL_SECRET=

# --- External scheduler -------------------------------------------------------
# Shops processed by POST /api/cron/nightly (comma separated).
BESTSELLER_CRON_SHOPS=
# At least 24 random characters. The scheduler sends: Authorization: Bearer <secret>
BESTSELLER_CRON_SECRET=
