# Environment variables for Bibs Trending Labels.
#
# RENDER (live) - web service, set exactly these five:
#   SCOPES=read_products,read_reports,write_products
#   SHOPIFY_API_KEY=<client ID of Bibs Trending Labels>
#   SHOPIFY_API_SECRET=<client secret of Bibs Trending Labels>
#   SHOPIFY_APP_URL=https://bibs-trending-labels.onrender.com
#   BESTSELLER_CRON_SECRET=<random, at least 24 characters>
# RENDER (live) - cron job: SHOPIFY_APP_URL and BESTSELLER_CRON_SECRET, same values.
# The database needs no variable: with a disk at /var/data it is /var/data/prod.sqlite.
#
# LOCAL - copy this file to .env. `shopify app dev` sets SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES itself.
#
# Every other variable is optional: NOT SET = the default written next to it,
# SET (even to an empty value) = always wins.

# --- Local development -------------------------------------------------------
# SQLite file for `shopify app dev`, relative to prisma/schema.prisma
# (= prisma/dev.sqlite). Not needed on Render.
DATABASE_URL="file:dev.sqlite"
# The dev store is not on Europe/Copenhagen time; allow it with a warning.
# Never set this on Render.
BESTSELLER_ALLOW_TIMEZONE_MISMATCH=true

# --- Nightly scheduler -------------------------------------------------------
# Secret for POST /api/cron/nightly (Authorization: Bearer <secret>), at least
# 24 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BESTSELLER_CRON_SECRET=

# --- Optional overrides (uncomment to change a default) ----------------------
# Shops processed every night. Default * = every store that has the app
# installed. Or a comma-separated list of myshopify domains. Empty = none.
# BESTSELLER_CRON_SHOPS=*
#
# Shops whose tags the app may change. Default * = every installed store.
# Each store still needs Settings -> Store updates switched on in the app.
# BESTSELLER_APPLY_ALLOWED_SHOPS=*
#
# Default true. false = no tag changes in any store (emergency stop).
# BESTSELLER_APPLY_ENABLED=true
#
# Default true. false = send no email events to Shopify Flow.
# BESTSELLER_FLOW_TRIGGER_ENABLED=true
#
# Tag used until one is chosen in Settings. Default label:Trending.
# BESTSELLER_LABEL_TAG=label:Trending
#
# Signs the email approval and undo links. Default SHOPIFY_API_SECRET.
# BESTSELLER_APPROVAL_SECRET=
#
# Development only: include today's sales in the period. Default false.
# BESTSELLER_DEV_WINDOW_INCLUDE_TODAY=false
